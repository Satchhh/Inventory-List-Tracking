<Window x:Class="InventoryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Entry" Height="720" Width="980"
        Background="#F7F9FA"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: entry form -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Add Inventory Item" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,14" Visibility="Collapsed"/>

                <!-- Serial number -->
                <TextBlock Text="Serial Number" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SerialBox" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="⧉" Style="{StaticResource CopyButton}"
                            Click="CopySerial_Click"/>
                </Grid>
                <CheckBox x:Name="NoSerialCheck" Content="No serial number on this item"
                          Margin="0,-4,0,12" Checked="NoSerialCheck_Changed" Unchecked="NoSerialCheck_Changed"/>

                <!-- Article number -->
                <TextBlock Text="Article / Part Number" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ArticleBox" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="⧉" Style="{StaticResource CopyButton}"
                            Click="CopyArticle_Click"/>
                </Grid>

                <!-- Type / model -->
                <TextBlock Text="Type / Model (as printed on the item, e.g. CP 443-1)" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TypeModelCombo" IsEditable="True"/>

                <!-- Category -->
                <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CategoryCombo">
                    <ComboBoxItem Content="Programmable Controller / CPU"/>
                    <ComboBoxItem Content="Power Supply"/>
                    <ComboBoxItem Content="Base Unit"/>
                    <ComboBoxItem Content="Communication Module"/>
                    <ComboBoxItem Content="Communication Processor"/>
                    <ComboBoxItem Content="Analog Input Module"/>
                    <ComboBoxItem Content="Analog Output Module"/>
                    <ComboBoxItem Content="Digital Input Module"/>
                    <ComboBoxItem Content="Digital Output Module"/>
                    <ComboBoxItem Content="Memory Card"/>
                    <ComboBoxItem Content="Bus / Front Connector"/>
                    <ComboBoxItem Content="Interface Module"/>
                    <ComboBoxItem Content="AS-Interface Module"/>
                    <ComboBoxItem Content="HMI / Operator Panel"/>
                    <ComboBoxItem Content="Media Converter"/>
                    <ComboBoxItem Content="Rail / Mounting"/>
                    <ComboBoxItem Content="Unknown"/>
                </ComboBox>

                <!-- Description -->
                <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescriptionBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                <!-- Country of manufacture -->
                <TextBlock Text="Country of Manufacture" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CountryCombo" IsEditable="True">
                    <ComboBoxItem Content="Japan"/>
                    <ComboBoxItem Content="Germany"/>
                    <ComboBoxItem Content="China"/>
                    <ComboBoxItem Content="Malaysia"/>
                    <ComboBoxItem Content="Singapore"/>
                    <ComboBoxItem Content="USA"/>
                    <ComboBoxItem Content="Unknown"/>
                </ComboBox>

                <!-- Supplier -->
                <TextBlock Text="Supplier" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="SupplierBox"/>

                <!-- Location -->
                <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="LocationCombo" IsEditable="True">
                    <ComboBoxItem Content="Left Cabinet"/>
                    <ComboBoxItem Content="Right Cabinet"/>
                </ComboBox>

                <!-- Remarks -->
                <TextBlock Text="Remarks" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="RemarksBox" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" Width="120"/>
                    <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                            Click="Clear_Click" Margin="8,0,0,0"/>
                    <Button Content="Copy Row" Style="{StaticResource SecondaryButton}"
                            Click="CopyRow_Click" Margin="8,0,0,0"
                            ToolTip="Copies all fields as tab-separated text, ready to paste into another spreadsheet in one go"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: recent entries -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="Recent Entries" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListView x:Name="RecentEntriesList" BorderThickness="1" BorderBrush="#D1D5DB" Background="White">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Serial" DisplayMemberBinding="{Binding SerialNumber}" Width="120"/>
                        <GridViewColumn Header="Article" DisplayMemberBinding="{Binding ArticleNumber}" Width="160"/>
                        <GridViewColumn Header="Type" DisplayMemberBinding="{Binding TypeModel}" Width="120"/>
                        <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock Text="Tip: Tab moves between fields; Enter on the last field saves."
                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
