<Window x:Class="InventoryApp.Views.DuplicateWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial number already exists"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Border BorderBrush="{StaticResource WarnBrush}" BorderThickness="1.5" Padding="20">
        <StackPanel>
            <TextBlock Text="⚠ Serial number already exists"
                       FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource WarnBrush}"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6"/>

            <Border Background="{StaticResource WarnLightBrush}" CornerRadius="4" Padding="10" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock x:Name="ExistingArticleText" FontSize="12"/>
                    <TextBlock x:Name="ExistingTypeText" FontSize="12"/>
                    <TextBlock x:Name="ExistingLocationText" FontSize="12"/>
                </StackPanel>
            </Border>

            <TextBlock Text="This can happen legitimately (e.g. a shared lot/date code), so saving is still allowed."
                       TextWrapping="Wrap" FontSize="11" FontStyle="Italic"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save Anyway" Style="{StaticResource PrimaryButton}"
                        Click="SaveAnyway_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
